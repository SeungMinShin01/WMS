{
  "title": "WMS 측정",
  "uid": "wms-measure",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "데이터 소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "DB 연결 풀 (사용 / 대기)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{application=\"wms-core\"}",
          "legendFormat": "사용 중"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending{application=\"wms-core\"}",
          "legendFormat": "대기"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_max{application=\"wms-core\"}",
          "legendFormat": "최대"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "처리량 (req/s, actuator 제외)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"wms-core\", uri!~\"/actuator.*\"}[30s]))",
          "legendFormat": "전체"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 응답 시간 (actuator 제외)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"wms-core\", uri!~\"/actuator.*\"}[30s])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx 에러 (req/s)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"wms-core\", status=~\"5..\"}[30s]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "적재 대기열 (쌓인 작업 / 실행 중 워커)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "executor_queued_tasks{application=\"wms-core\", name=\"carryExecutor\"}",
          "legendFormat": "대기열"
        },
        {
          "refId": "B",
          "expr": "executor_active_threads{application=\"wms-core\", name=\"carryExecutor\"}",
          "legendFormat": "실행 중 워커"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB 연결 (1분 최대 사용 / 대기 최대 시간)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(hikaricp_connections_active{application=\"wms-core\"}[1m])",
          "legendFormat": "최대 사용 연결"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_acquire_seconds_max{application=\"wms-core\"} * 1000",
          "legendFormat": "연결 얻는 최대 시간(ms)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "응답 코드별 요청 수 (k6)",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(k6_http_reqs_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p99 응답 시간 (actuator 제외)",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"wms-core\", uri!~\"/actuator.*\"}[30s])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
