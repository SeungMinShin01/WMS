{
  "title": "WMS 측정",
  "uid": "wms-measure",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "데이터 소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "DB 연결 풀 (사용 / 대기)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{application=\"wms-core\"}",
          "legendFormat": "사용 중"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending{application=\"wms-core\"}",
          "legendFormat": "대기"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_max{application=\"wms-core\"}",
          "legendFormat": "최대"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "처리량 (req/s, actuator 제외)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"wms-core\", uri!~\"/actuator.*\"}[30s]))",
          "legendFormat": "전체"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 응답 시간 (actuator 제외)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"wms-core\", uri!~\"/actuator.*\"}[30s])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx 에러 (req/s)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"wms-core\", status=~\"5..\"}[30s]))",
          "legendFormat": "5xx"
        }
      ]
    }
  ]
}
