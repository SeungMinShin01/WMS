#!/bin/sh
# 커밋 메시지 형식 검사. 설치: git config core.hooksPath .githooks (clone한 사람마다 1번)

# 로케일에 따라 grep 이 한글을 다르게 다루는 문제를 피하기 위해 바이트 단위로 고정
export LC_ALL=C

msg=$(head -n1 "$1")

# git이 자동으로 만드는 메시지는 검사하지 않는다
case "$msg" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

# type/scope 는 ci.yml 의 PATTERN 과 같게 유지한다.
# 제목 50자 제한은 로케일(한글 바이트 수) 영향을 받아 로컬에서는 검사하지 않고 CI 에서만 검사한다.
PATTERN='^(feat|fix|refactor|perf|test|docs|chore|merge|release)(\((global|document|inbound|stock|outbound|product|partner|location|portal|frontend)\))?: .+$'

if ! printf '%s' "$msg" | grep -Eq "$PATTERN"; then
  echo ""
  echo "❌ 커밋 메시지 형식이 아닙니다: $msg"
  echo ""
  echo "   형식 : <type>(<scope>): <제목> (ED-숫자)   ← (ED-숫자)는 생략 가능"
  echo "   type : feat fix refactor perf test docs chore merge release"
  echo "   scope: global document inbound stock outbound product partner location portal frontend"
  echo "   제목 : 50자 이내, 한 커밋에 스토리 하나"
  echo "   예시 : feat(inbound): 입고 문서 목록 조회 API (ED-13)"
  echo ""
  exit 1
fi

exit 0